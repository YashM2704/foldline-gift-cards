{
  "name": "gift-card-kit",
  "version": "1.0.0",
  "private": true,
  "description": "A gift card kit built with Hyper Elements: one gift's values make its card image, delivery email, balance page, printable fold-in card and share images.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "render": "tsx scripts/render.ts",
    "check": "hyper-elements check src/templates",
    "describe": "hyper-elements describe src/templates/card-image.tsx",
    "test": "tsx --test test/kit.test.tsx",
    "typecheck": "tsc --noEmit",
    "metrics": "tsx scripts/metrics.ts"
  },
  "hyperElements": {
    "templates": [
      "src/**"
    ]
  },
  "dependencies": {
    "@hyper-elements/react": "^0.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@hyper-elements/cli": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hyper-elements/email-clients": "^0.5.0"
  }
}
